$tests = array(1, "tariq", 1.5, true, 7, 's', false);

// 1. باستخدام Loop For
echo "--- باستخدام FOR --- <br>";
for ($i = 0; $i < count($tests); $i++) {
    if (is_bool($tests[$i])) {
        continue;
    }
    echo $tests[$i] . " ";
}

echo "<br><br>";

// 2. باستخدام Loop While
echo "--- باستخدام WHILE --- <br>";
$j = 0;
while ($j < count($tests)) {
    if (!is_bool($tests[$j])) {
        echo $tests[$j] . " ";
    }
    $j++;
}
