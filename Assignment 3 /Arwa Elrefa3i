<?php
function RouteBubble($arr) {
    $n = count($arr);
    for ($i = 0; $i < $n - 1; $i++) {
        for ($j = 0; $j < $n - $i - 1; $j++) {
            if ($arr[$j] > $arr[$j + 1]) {
                // تبديل العناصر
                $temp = $arr[$j];
                $arr[$j] = $arr[$j + 1];
                $arr[$j + 1] = $temp;
            }
        }
    }
    return $arr;
}

// تجربة الدالة
$arr = array(64, 34, 25, 12, 22, 11, 90);
print_r(RouteBubble($arr));
?>
