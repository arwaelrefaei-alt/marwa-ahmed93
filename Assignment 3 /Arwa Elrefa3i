<?php
if (isset($_POST['submit'])) {
    $price = $_POST['price'];
    $quantity = $_POST['quantity'];

    // التحقق للتأكد من أن المدخلات أرقام وليست حروف
    if (!is_numeric($price) || !is_numeric($quantity)) {
        echo "<span style='color:red;'>خطأ: يرجى إدخال أرقام فقط بدلاً من الحروف!</span>";
    } 
    // التحقق من الأرقام السالبة
    elseif ($price < 0 || $quantity < 0) {
        echo "<span style='color:red;'>رقم سالب! منفضلك ادخل ارقام موجبه</span>";
    } 
    // الحسابات في حالة كانت المدخلات صحيحة
    else {
        $total_before_discount = $price * $quantity;
        
        // تحديد نسبة الخصم
        if ($total_before_discount < 1000) {
            $discount_percentage = 0.10; // 10%
        } else {
            $discount_percentage = 0.15; // 15%
        }
        
        $discount_value = $total_before_discount * $discount_percentage;
        $total_after_discount = $total_before_discount - $discount_value;
        
        // عرض النتائج على الشاشة
        echo "<h3>تفاصيل الفاتورة:</h3>";
        echo "السعر الكلي قبل الخصم: " . $total_before_discount . " ج<br>";
        echo " الخصم (" . ($discount_percentage * 100) . "%): " . $discount_value . " ج<br>";
        echo "السعر الكلي بعد الخصم: " . $total_after_discount . " ج<br>";
    }
}
?>

