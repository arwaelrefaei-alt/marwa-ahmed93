body {
    background-color: #16232e;
    margin: 0;
    padding: 20px;
    font-family: 'Courier New', Courier, monospace;
}

.header h1 {
    color: #c29b40;
    font-family: 'Times New Roman', Times, serif;
    margin-bottom: 5px;
    font-size: 28px;
}

.header p {
    color: #ffffff;
    font-family: 'Times New Roman', Times, serif;
    margin-top: 0;
    margin-bottom: 20px;
    font-size: 15px;
}

table {
    width: 100%;
    border-collapse: collapse;
    background-color: #365985;
}

td {
    border: 2px solid #000000;
    width: 25%;
    vertical-align: middle;
}

.text-cell {
    padding: 15px;
    color: #000000;
    font-size: 13px;
    font-weight: bold;
    line-height: 1.5;
}

.img-cell {
    padding: 0;
}

.img-cell img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
}
